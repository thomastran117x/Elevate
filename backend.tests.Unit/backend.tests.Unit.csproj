<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Coverlet instruments backend.dll with Mono.Cecil, which must resolve every referenced
         assembly from the test output folder. Without this, framework-provided assemblies are
         absent, instrumentation of backend.dll fails, and it is silently dropped from coverage. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\backend\backend.csproj" />
    <ProjectReference Include="..\backend\src\worker\email-worker\email-worker.csproj" />
    <ProjectReference Include="..\backend\src\worker\sms-worker\sms-worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\backend\src\worker\club-indexer\ClubIndexerMessageParser.cs" Link="Worker\ClubIndexerMessageParser.cs" />
    <Compile Include="..\backend\src\worker\clubpost-indexer\ClubPostIndexerMessageParser.cs" Link="Worker\ClubPostIndexerMessageParser.cs" />
    <Compile Include="..\backend\src\worker\event-indexer\EventIndexerMessageParser.cs" Link="Worker\EventIndexerMessageParser.cs" />
  </ItemGroup>

</Project>
