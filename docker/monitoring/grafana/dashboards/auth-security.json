{
  "uid": "auth-security",
  "title": "Auth security",
  "description": "Authentication and authorization security signals for EventXperience. See docs/operations/monitoring.md.",
  "tags": [
    "eventxperience",
    "auth",
    "security"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(target_info, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "targetBlank": true,
      "url": "https://github.com/thomastran117x/Elevate/blob/main/docs/operations/README.md"
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Sign-in outcomes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Sign-ins by outcome and reason",
      "description": "auth.sign_in.* events per second. Refreshes are not sign-ins.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event, outcome, reason) (rate(auth_security_events_total{event=~\"auth.sign_in.*\", deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{event}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Sign-ins by method",
      "description": "Successful, failed, and challenged sign-ins by password, OAuth provider, or passkey.",
