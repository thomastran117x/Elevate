{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Profile": {
    "UsernameChangeCooldownDays": 30
  },
  "Auth": {
    "AbuseProtection": {
      "KeyPrefix": "auth:abuse:v1",
      "SharedIpPermitLimit": 10,
      "SharedIpWindow": "00:05:00",
      "LoginAccountFailureLimit": 10,
      "LoginAccountFailureWindow": "00:15:00",
      "RecoveryTargetPermitLimit": 3,
      "RecoveryTargetWindow": "01:00:00",
      "VerificationTargetPermitLimit": 5,
      "VerificationTargetWindow": "00:15:00",
      "OAuthCompletionTargetPermitLimit": 5,
      "OAuthCompletionTargetWindow": "00:15:00",
      "MfaDeliveryTargetPermitLimit": 5,
      "MfaDeliveryTargetWindow": "00:15:00",
      "EmailAvailabilityIpPermitLimit": 15,
      "EmailAvailabilityIpWindow": "00:01:00",
      "EmailAvailabilityTargetPermitLimit": 5,
      "EmailAvailabilityTargetWindow": "00:15:00",
      "CaptchaFailureThreshold": 3,
      "DelayBase": "00:00:00.500",
      "DelayMaximum": "00:00:08"
    }
  },
  "BloomFilters": {
    "RefreshIntervalSeconds": 30,
    "RebuildIntervalHours": 6,
    "RetiredGenerationTtlMinutes": 60,
    "LocalReplayWindowMinutes": 30,
    "ForcedRebuildCooldownMinutes": 15,
    "Targets": {
      "username": {
        "ExpectedItems": 250000,
        "FalsePositiveRate": 0.01
      },
      "email": {
        "ExpectedItems": 250000,
        "FalsePositiveRate": 0.01
      }
    }
  }
}
